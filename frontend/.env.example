# O frontend lê as configurações do mesmo backend/.env (fora das pastas
# públicas). Estas são as que ele usa; copie-as para lá se precisar.

# Endereço do backend visto do servidor do frontend. Vazio = http://127.0.0.1:8000
ELOS_API_URL=

# A mesma chave definida no backend (se ele usar ELOS_API_CHAVE).
ELOS_API_CHAVE=
