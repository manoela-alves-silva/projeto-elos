# Libera esta pasta: o backend/.htaccess bloqueia tudo do backend, e o
# Apache aplica esse bloqueio também às subpastas.
Require all granted

# Apache: toda rota /api/... vai para o index.php (no servidor embutido
# do PHP isso já acontece sozinho; no Apache, sem isto, dá 404).
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
