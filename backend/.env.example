# Exemplos de configuração do banco de dados do ELOS.
# Não inclua credenciais reais neste arquivo.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elos_db
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_CHARSET=utf8mb4

# E-mails (separados por vírgula) que assumem como GESTOR ao se cadastrar,
# ou ao entrar quando o sistema ainda não tem nenhum gestor.
# Depois disso, os perfis são trocados pela tela Equipe.
ELOS_GESTORES=

# Mostra detalhes de erro nas respostas da API. Use 1 só no seu
# computador; em produção deixe vazio (os erros vão para o log).
ELOS_DEBUG=

# Entrar com Google: ID e segredo do cliente OAuth (tipo "Aplicativo da
# Web"), criados no Google Cloud Console. Vazios = botão avisa que não
# está configurado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
